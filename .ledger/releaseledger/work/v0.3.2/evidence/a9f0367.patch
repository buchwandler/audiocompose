+def _variant_name(variant: str) -> None:
+    if (
+        not isinstance(variant, str)
+        or not variant
+        or variant in {".", ".."}
+        or "/" in variant
+        or "\\" in variant
+        or "\x00" in variant
+        or PureWindowsPath(variant).drive
+    ):
+        raise _error(
+            "variant.invalid", "--variant must be a single directory basename", variant=variant

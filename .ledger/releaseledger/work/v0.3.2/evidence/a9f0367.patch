+    )
+    explicit_job = load_job(explicit_result.audiojob)
+    assert explicit_result.request.pause_policy_provenance == "explicit"
+    assert next(
+        item for item in explicit_job.items if isinstance(item, Silence)
+    ).seconds == pytest.approx(0.41)
